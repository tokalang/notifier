import std/io::{println}
import std/vec::{Vec}
import core/result::{Result}
import std/fs::{read_to_string}
import std/thread::{sleep_ms}
import std/net::{resolve_ipv4, SocketAddrV4, TcpStream}
import stdx/net/url::{Url, parse_url}
import stdx/net/http::{HttpClient, HttpRequest, HttpMethod, HeaderMap, HttpResponseStream}
import stdx/net/stream::{AsyncStream}
import stdx/net/tls::{TlsStream}
import stdx/serde/json as json
import src/config::{Config, HeaderEntry}
import src/security::{validate_endpoint_security, is_reserved_system_header, is_sensitive_header}
import src/hasher::{compute_sha256_hex}

const MAX_BODY_LIMIT_BYTES = 1048576:usize // Exact 1 MiB limit

fn validate_json_payload(input: str) -> Result<bool, string> {
    auto skipped_res = json::json_skip_value(input)
    if skipped_res.is_err() {
        return Result<bool, string>::Err(string::from("Malformed JSON structure"))
    }
    auto rem = json::json_skip_whitespace(skipped_res.unwrap())
    if rem.len() > 0:usize {
        return Result<bool, string>::Err(string::from("Trailing unparsed data in JSON payload"))
    }

    auto brace_count# = 0:i32
    auto bracket_count# = 0:i32
    auto in_str# = false
    auto escape# = false
    auto i# = 0:usize
    loop i < input.len() {
        auto b = input.byte_at(i)
        if in_str {
            if escape {
                escape = false
            } else if b == '\\' {
                escape = true
            } else if b == '"' {
                in_str = false
            }
        } else {
            if b == '"' {
                in_str = true
            } else if b == '{' {
                brace_count += 1
            } else if b == '}' {
                brace_count -= 1
                if brace_count < 0 { return Result<bool, string>::Err(string::from("Unmatched '}'")) }
            } else if b == '[' {
                bracket_count += 1
            } else if b == ']' {
                bracket_count -= 1
                if bracket_count < 0 { return Result<bool, string>::Err(string::from("Unmatched ']'")) }
            }
        }
        i += 1
    }
    if in_str { return Result<bool, string>::Err(string::from("Unterminated string literal in JSON")) }
    if brace_count != 0 { return Result<bool, string>::Err(string::from("Unclosed '{' in JSON")) }
    if bracket_count != 0 { return Result<bool, string>::Err(string::from("Unclosed '[' in JSON")) }

    return Result<bool, string>::Ok(true)
}

fn drain_response_body(resp_stream#: HttpResponseStream, timeout_ms: i32) -> async Result<usize, string> {
    auto total_read# = 0:usize
    auto chunk_buf# = Vec<u8>::with_capacity(4096)

    loop {
        if total_read == MAX_BODY_LIMIT_BYTES {
            // Exact 1-byte probe to distinguish exact 1 MiB from overflow
            auto probe_res = resp_stream#.read_chunk_into_async(cede chunk_buf, 1:usize, timeout_ms).await
            if probe_res.is_err() {
                auto p_err# = probe_res.unwrap_err()
                return Result<usize, string>::Err(p_err.message.clone())
            }
            auto p_res# = probe_res.unwrap()
            auto p_n = p_res.bytes_read
            chunk_buf = p_res#.take_buffer()
            if p_n > 0:usize {
                return Result<usize, string>::Err(string::from("Response body exceeded 1 MiB limit"))
            }
            break
        }

        auto remaining = MAX_BODY_LIMIT_BYTES - total_read
        auto to_request# = 4096:usize
        if to_request > remaining {
            to_request = remaining
        }

        auto read_res = resp_stream#.read_chunk_into_async(cede chunk_buf, to_request, timeout_ms).await
        if read_res.is_err() {
            auto err# = read_res.unwrap_err()
            return Result<usize, string>::Err(err.message.clone())
        }
        auto res# = read_res.unwrap()
        auto n = res.bytes_read
        chunk_buf = res#.take_buffer()

        if n == 0:usize {
            break
        }

        total_read += n
    }

    return Result<usize, string>::Ok(total_read)
}

pub fn execute_delivery(cfg: Config, event_path: string, dry_run: bool, cli_insecure_override: bool) -> async i32 {
    // 1. Read event payload
    auto payload_res = read_to_string(event_path.clone())
    if payload_res.is_err() {
        println("[ERROR] Failed to read event file '{}'", event_path)
        return 1
    }
    auto raw_payload = payload_res.unwrap()

    // 2. Validate JSON syntax (fail closed on malformed JSON)
    auto json_val_res = validate_json_payload(raw_payload.as_str())
    if json_val_res.is_err() {
        println("[ERROR] Event payload '{}' is not valid JSON: {}", event_path, json_val_res.unwrap_err())
        return 1
    }

    // 3. Compute raw-byte SHA-256 idempotency key
    auto idempotency_key = compute_sha256_hex(raw_payload.as_str())

    // 4. Parse URL and validate security policy
    auto url_res = parse_url(cfg.endpoint.clone())
    if url_res.is_err() {
        println("[ERROR] Invalid endpoint URL '{}': {}", cfg.endpoint, url_res.unwrap_err())
        return 1
    }
    auto url = url_res.unwrap()

    auto allow_insecure = cfg.allow_insecure_http || cli_insecure_override
    auto sec_res = validate_endpoint_security(url.scheme.clone(), url.host.clone(), allow_insecure)
    if sec_res.is_err() {
        println("[ERROR] Security policy violation: {}", sec_res.unwrap_err())
        return 1
    }
    auto insecure_override_used = sec_res.unwrap()

    // 5. Construct request path with query string
    auto req_path# = string::from("")
    if url.path.len() == 0:usize {
        req_path#.push_str("/")
    } else {
        req_path#.push_str(url.path.as_str())
    }
    if url.query.len() > 0:usize {
        req_path#.push_str("?")
        req_path#.push_str(url.query.as_str())
    }

    // 6. Construct Host header (include port if non-standard)
    auto host_header# = string::from(url.host.as_str())
    auto eff_port = url.effective_port()
    auto is_non_standard# = false
    if url.is_tls() {
        if eff_port != 443:u16 { is_non_standard = true }
    } else {
        if eff_port != 80:u16 { is_non_standard = true }
    }
    if is_non_standard {
        host_header#.push_str(":")
        host_header#.push_str(string::from_int(eff_port as i32).as_str())
    }

    // 7. Assemble headers (Custom headers first, then system reserved headers overwrite)
    auto header_map# = HeaderMap::new()
    auto h_idx# = 0:usize
    loop h_idx < cfg.headers.len() {
        auto *entry = cfg.headers.get_ref(h_idx)
        if is_reserved_system_header(entry.key.clone()) {
            println("[ERROR] Custom header defines reserved system header '{}'", entry.key)
            return 1
        }
        auto ins_res = header_map#.insert(entry.key.clone(), entry.value.clone())
        if ins_res.is_err() {
            println("[ERROR] Failed to insert custom header '{}': {}", entry.key, ins_res.unwrap_err())
            return 1
        }
        h_idx += 1
    }

    // System reserved headers (enforced)
    header_map#.insert(string::from("Host"), host_header#.clone())
    header_map#.insert(string::from("Content-Type"), string::from("application/json"))
    header_map#.insert(string::from("Content-Length"), string::from_int(raw_payload.len() as i32))
    header_map#.insert(string::from("Idempotency-Key"), idempotency_key.clone())
    header_map#.insert(string::from("User-Agent"), string::from("toka-notifier/0.1.3-dev"))
    header_map#.insert(string::from("Connection"), string::from("close"))

    // 8. Dry-Run Handling
    if dry_run {
        println("=== NOTIFIER DRY RUN SIMULATION ===")
        if insecure_override_used {
            println("[WARNING: INSECURE OVERRIDE] Target endpoint uses unencrypted HTTP over public network!")
        }
        println("Target Endpoint: {}", cfg.endpoint)
        println("Target Host:     {} (effective port {})", url.host, string::from_int(eff_port as i32))
        if url.is_tls() {
            println("TLS Enabled:     true")
        } else {
            println("TLS Enabled:     false")
        }
        if cfg.ca_file.len() > 0:usize {
            println("Custom CA File:  {}", cfg.ca_file)
        }
        println("Method:          POST")
        println("Request Path:    {}", req_path)
        println("Payload Size:    {} bytes", string::from_int(raw_payload.len() as i32))
        println("Idempotency-Key: {}", idempotency_key)
        println("Outbound Headers (Redacted):")
        auto d_idx# = 0:usize
        loop d_idx < header_map.entries.len() {
            auto *entry = header_map.entries.get_ref(d_idx)
            auto display_val# = string::from("")
            if is_sensitive_header(entry.key.clone()) {
                display_val = string::from("[REDACTED]")
            } else {
                display_val = entry.value.clone()
            }
            println("  {}: {}", entry.key, display_val)
            d_idx += 1
        }
        println("=== DRY RUN FINISHED (No network connection performed) ===")
        return 0
    }

    if insecure_override_used {
        println("[WARNING: INSECURE OVERRIDE] Target endpoint uses unencrypted HTTP over public network!")
    }

    // 9. Prepare HTTP Request Object
    auto http_req# = HttpRequest(
        method = HttpMethod::POST,
        path = req_path.clone(),
        version = string::from("HTTP/1.1"),
        headers = header_map.clone(),
        body = raw_payload.clone()
    )

    auto client = HttpClient::new(cfg.timeout_ms)
    auto total_attempts = 1:i32 + cfg.max_retries
    auto attempt# = 1:i32

    loop attempt <= total_attempts {
        if attempt > 1:i32 {
            auto backoff = (cfg.backoff_ms * (attempt - 1:i32)) as u32
            println("[INFO] Retrying delivery (attempt {}/{}) after {}ms backoff...",
                    string::from_int(attempt), string::from_int(total_attempts), string::from_int(backoff as i32))
            sleep_ms(backoff)
        }

        // DNS Resolve
        auto ip_res = resolve_ipv4(url.host.clone())
        if ip_res.is_err() {
            println("[WARN] Attempt {}/{}: DNS resolution failed for host '{}': {}",
                    string::from_int(attempt), string::from_int(total_attempts), url.host, ip_res.unwrap_err())
            attempt += 1
            continue
        }
        auto target_ip = ip_res.unwrap()
        auto sock_addr = SocketAddrV4::new(target_ip, eff_port)

        // TCP Connect
        auto conn_res = TcpStream::connect_async_timeout(sock_addr, cfg.timeout_ms).await
        if conn_res.is_err() {
            println("[WARN] Attempt {}/{}: TCP connection failed to {}:{}: {}",
                    string::from_int(attempt), string::from_int(total_attempts),
                    url.host, string::from_int(eff_port as i32), conn_res.unwrap_err())
            attempt += 1
            continue
        }
        auto tcp_stream# = conn_res.unwrap()

        // TLS Handshake or Plain Stream
        auto stream_res# = Result<AsyncStream, string>::Err(string::from("uninitialized"))
        if url.is_tls() {
            if cfg.ca_file.len() > 0:usize {
                stream_res = TlsStream::connect_with_ca_file_async_timeout(tcp_stream#.take(), url.host.clone(), cfg.ca_file.clone(), cfg.timeout_ms).await
            } else {
                stream_res = TlsStream::connect_with_verify_async_timeout(tcp_stream#.take(), url.host.clone(), true, cfg.timeout_ms).await
            }
        } else {
            stream_res = Result<AsyncStream, string>::Ok(AsyncStream::from_tcp(tcp_stream#.take()))
        }

        if stream_res.is_err() {
            println("[WARN] Attempt {}/{}: Stream/TLS negotiation failed: {}",
                    string::from_int(attempt), string::from_int(total_attempts), stream_res.unwrap_err())
            attempt += 1
            continue
        }
        auto async_stream# = stream_res.unwrap()

        // Execute HTTP Request
        auto req_copy = http_req#.clone()
        auto exec_res = client.execute_on_stream_async(req_copy, cede async_stream).await
        if exec_res.is_err() {
            println("[WARN] Attempt {}/{}: HTTP transmission failed: {}",
                    string::from_int(attempt), string::from_int(total_attempts), exec_res.unwrap_err())
            attempt += 1
            continue
        }

        auto resp_stream# = exec_res.unwrap()
        auto status = resp_stream.status_code

        // Status code discrimination (Status-First)
        if status >= 300 && status < 400 {
            println("[ERROR] Delivery failed with redirect status {} (automatic redirects forbidden to prevent SSRF). Non-retryable.",
                    string::from_int(status))
            return 1
        } else if status >= 400 && status < 500 {
            println("[ERROR] Delivery failed with client/policy error status {}. Non-retryable.",
                    string::from_int(status))
            return 1
        } else if status >= 500 {
            // 5xx Server Error -> Retryable
            println("[WARN] Attempt {}/{}: Server returned error status {}",
                    string::from_int(attempt), string::from_int(total_attempts), string::from_int(status))
            attempt += 1
            continue
        } else if status >= 200 && status < 300 {
            // 2xx -> Only drain body for successful delivery
            auto drain_res = drain_response_body(resp_stream#, cfg.timeout_ms).await
            if drain_res.is_err() {
                println("[ERROR] Delivery failed: 2xx response body reading failed or exceeded 1 MiB limit ({}). Non-retryable.",
                        drain_res.unwrap_err())
                return 1
            }
            println("[SUCCESS] Delivered event to {} (Status: {}, Idempotency-Key: {}, Attempts: {})",
                    cfg.endpoint, string::from_int(status), idempotency_key, string::from_int(attempt))
            return 0
        } else {
            println("[ERROR] Unexpected status code {}. Non-retryable.", string::from_int(status))
            return 1
        }
    }

    println("[ERROR] Delivery failed: all {} attempts exhausted for endpoint '{}'",
            string::from_int(total_attempts), cfg.endpoint)
    return 1
}
