import std/vec::{Vec}
import core/result::{Result}
import core/option::{Option}
import std/fs::{read_to_string}
import stdx/serde/yaml as yaml
import stdx/serde/json::{JsonNode}
import src/security::{is_reserved_system_header}

pub shape HeaderEntry (
    key: string,
    value: string
)

impl HeaderEntry@Encap {
    pub key, value
    fn drop(self#) {}
}

impl HeaderEntry {
    pub fn clone(self) -> HeaderEntry {
        return HeaderEntry(
            key = string::from(self.key.as_str()),
            value = string::from(self.value.as_str())
        )
    }
}

pub shape Config (
    endpoint: string,
    timeout_ms: i32,
    max_retries: i32,
    backoff_ms: i32,
    allow_insecure_http: bool,
    ca_file: string,
    headers: Vec<HeaderEntry>
)

impl Config@Encap {
    pub endpoint, timeout_ms, max_retries, backoff_ms, allow_insecure_http, ca_file, headers
    fn drop(self#) {}
}

impl Config {
    pub fn clone(self) -> Config {
        auto h_copy# = Vec<HeaderEntry>::new()
        auto i# = 0:usize
        loop i < self.headers.len() {
            auto *entry = self.headers.get_ref(i)
            h_copy#.push(cede entry.clone())
            i += 1
        }
        return Config(
            endpoint = string::from(self.endpoint.as_str()),
            timeout_ms = self.timeout_ms,
            max_retries = self.max_retries,
            backoff_ms = self.backoff_ms,
            allow_insecure_http = self.allow_insecure_http,
            ca_file = string::from(self.ca_file.as_str()),
            headers = cede h_copy
        )
    }
}

pub fn load_config_file(path: string) -> Result<Config, string> {
    auto file_res = read_to_string(path.clone())
    if file_res.is_err() {
        auto err# = string::from("Could not read configuration file '")
        err#.push_str(path.as_str())
        err#.push_str("': ")
        err#.push_str(file_res.unwrap_err().as_str())
        return Result<Config, string>::Err(cede err)
    }
    auto content = file_res.unwrap()

    auto parse_res = yaml::parse(content.as_str())
    if parse_res.is_err() {
        auto y_err = parse_res.unwrap_err()
        auto err# = string::from("YAML parsing failed in '")
        err#.push_str(path.as_str())
        err#.push_str("': ")
        err#.push_str(y_err.to_string().as_str())
        return Result<Config, string>::Err(cede err)
    }

    auto root_node = parse_res.unwrap()
    match root_node {
        auto JsonNode::ObjectNode(&map) => {
            auto endpoint# = string::from("")
            auto has_endpoint# = false
            auto timeout_ms# = 5000:i32
            auto max_retries# = 3:i32
            auto backoff_ms# = 100:i32
            auto allow_insecure_http# = false
            auto ca_file# = string::from("")
            auto headers# = Vec<HeaderEntry>::new()

            auto it# = map.iter()
            loop true {
                auto entry_opt = it#.next()
                if entry_opt.is_none() { break }
                auto entry = entry_opt.unwrap()
                auto *key_ptr = entry.key()
                auto *val_ptr = entry.val()
                auto key_str = string::from(key_ptr.as_str())

                if key_str.as_str().equals("endpoint") {
                    match val_ptr {
                        auto JsonNode::StrNode(&s) => {
                            if s.len() == 0:usize {
                                return Result<Config, string>::Err(string::from("Configuration field 'endpoint' cannot be empty"))
                            }
                            endpoint = string::from(s.as_str())
                            has_endpoint = true
                        }
                        _ => return Result<Config, string>::Err(string::from("Configuration field 'endpoint' must be a string"))
                    }
                } else if key_str.as_str().equals("timeout_ms") {
                    match val_ptr {
                        auto JsonNode::NumNode(n) => {
                            if n < 1.0 || n > 300000.0 || (n as i64 as f64) != n {
                                return Result<Config, string>::Err(string::from("Configuration field 'timeout_ms' must be an integer between 1 and 300000"))
                            }
                            timeout_ms = n as i32
                        }
                        _ => return Result<Config, string>::Err(string::from("Configuration field 'timeout_ms' must be an integer between 1 and 300000"))
                    }
                } else if key_str.as_str().equals("max_retries") {
                    match val_ptr {
                        auto JsonNode::NumNode(n) => {
                            if n < 0.0 || n > 10.0 || (n as i64 as f64) != n {
                                return Result<Config, string>::Err(string::from("Configuration field 'max_retries' must be an integer between 0 and 10"))
                            }
                            max_retries = n as i32
                        }
                        _ => return Result<Config, string>::Err(string::from("Configuration field 'max_retries' must be an integer between 0 and 10"))
                    }
                } else if key_str.as_str().equals("backoff_ms") {
                    match val_ptr {
                        auto JsonNode::NumNode(n) => {
                            if n < 0.0 || n > 60000.0 || (n as i64 as f64) != n {
                                return Result<Config, string>::Err(string::from("Configuration field 'backoff_ms' must be an integer between 0 and 60000"))
                            }
                            backoff_ms = n as i32
                        }
                        _ => return Result<Config, string>::Err(string::from("Configuration field 'backoff_ms' must be an integer between 0 and 60000"))
                    }
                } else if key_str.as_str().equals("allow_insecure_http") {
                    match val_ptr {
                        auto JsonNode::BoolNode(b) => {
                            allow_insecure_http = b
                        }
                        _ => return Result<Config, string>::Err(string::from("Configuration field 'allow_insecure_http' must be a boolean"))
                    }
                } else if key_str.as_str().equals("ca_file") {
                    match val_ptr {
                        auto JsonNode::StrNode(&s) => {
                            ca_file = string::from(s.as_str())
                        }
                        _ => return Result<Config, string>::Err(string::from("Configuration field 'ca_file' must be a string"))
                    }
                } else if key_str.as_str().equals("headers") {
                    match val_ptr {
                        auto JsonNode::ObjectNode(&h_map) => {
                            auto h_it# = h_map.iter()
                            loop true {
                                auto h_entry_opt = h_it#.next()
                                if h_entry_opt.is_none() { break }
                                auto h_entry = h_entry_opt.unwrap()
                                auto *h_key_ptr = h_entry.key()
                                auto *h_val_ptr = h_entry.val()
                                auto h_key_str = string::from(h_key_ptr.as_str())

                                if is_reserved_system_header(h_key_str.clone()) {
                                    auto err# = string::from("Forbidden attempt to set reserved system header '")
                                    err#.push_str(h_key_str.as_str())
                                    err#.push_str("' in configuration 'headers'")
                                    return Result<Config, string>::Err(cede err)
                                }

                                match h_val_ptr {
                                    auto JsonNode::StrNode(&hs) => {
                                        headers#.push(cede HeaderEntry(
                                            key = string::from(h_key_str.as_str()),
                                            value = string::from(hs.as_str())
                                        ))
                                    }
                                    _ => {
                                        auto err# = string::from("Value for header '")
                                        err#.push_str(h_key_str.as_str())
                                        err#.push_str("' must be a string")
                                        return Result<Config, string>::Err(cede err)
                                    }
                                }
                            }
                        }
                        _ => return Result<Config, string>::Err(string::from("Configuration field 'headers' must be a mapping/object"))
                    }
                } else {
                    auto err# = string::from("Unknown configuration field '")
                    err#.push_str(key_str.as_str())
                    err#.push_str("'")
                    return Result<Config, string>::Err(cede err)
                }
            }

            if !has_endpoint {
                return Result<Config, string>::Err(string::from("Missing required configuration field 'endpoint'"))
            }

            return Result<Config, string>::Ok(Config(
                endpoint = cede endpoint,
                timeout_ms = timeout_ms,
                max_retries = max_retries,
                backoff_ms = backoff_ms,
                allow_insecure_http = allow_insecure_http,
                ca_file = cede ca_file,
                headers = cede headers
            ))
        }
        _ => return Result<Config, string>::Err(string::from("Root YAML document must be a mapping/object"))
    }
}
